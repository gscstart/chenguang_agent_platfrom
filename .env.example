# 应用
APP_NAME=辰光agent_web
APP_ENV=development
APP_DEBUG=true

# 数据库配置（对应 docker-compose.yaml）
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=123456
DB_NAME=chenguang

# Redis 配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
